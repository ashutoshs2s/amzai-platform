# ---------------------------------------------------------------------------
# Amzai Operations Platform: environment variables
#
# This file is a TEMPLATE. It is committed to the repo and contains no real
# values. Never put a real key in this file.
#
# To set up your machine:
#   1. Make a copy of this file and name the copy  .env.local
#   2. Replace each placeholder below with the real value from Supabase.
#   3. Restart the dev server.
#
# .env.local is listed in .gitignore, so it never leaves your machine.
# ---------------------------------------------------------------------------


# The address of your Supabase project.
# Supabase dashboard: Project Settings > Data API > Project URL.
# It always starts with https:// and ends with .supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The public key. Safe to appear in the browser, because row level security
# still applies to everything it does.
# Supabase dashboard: Project Settings > API Keys. Labelled "anon" and "public"
# on older projects, or "publishable" on newer ones. Either is the right one.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# The secret key. This one bypasses row level security entirely.
# Supabase dashboard: Project Settings > API Keys, labelled "service_role" and
# "secret". You will have to click to reveal it.
#
# It has no NEXT_PUBLIC_ prefix, and that is deliberate: the prefix is what
# tells Next.js a value may be sent to the browser. Without it, this value
# stays on the server. Never add the prefix to this line, never paste this key
# into any other file, and never paste it into a chat, an issue or a log.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ---------------------------------------------------------------------------
# Sending onboarding links
#
# The send sits behind one small interface (lib/client/mail), so changing
# provider is these variables and nothing else.
# ---------------------------------------------------------------------------

# Which provider sends. One of:
#
#   smtp      Google Workspace, SES, or anything else that speaks SMTP.
#   console   Development only. Prints the email, including the link, to the
#             terminal instead of sending it, so the whole flow can be walked
#             through before any provider is set up. It refuses to run in
#             production, because the link is a token and a token must never
#             be written to a log.
#   unset     Nothing is sent. The link is still issued and recorded.
MAIL_TRANSPORT=console

# The address clients see. Must be an address the SMTP account is allowed to
# send as: in Google Workspace that means the account itself, or an alias you
# have verified under Settings > Accounts > Send mail as.
MAIL_FROM=Amzai <onboarding@amzai.events>

# Optional, and worth setting. Where a client's reply goes: a mailbox a person
# reads. A transactional email nobody can reply to is a dead end.
MAIL_REPLY_TO=hello@amzai.events

# SMTP, when MAIL_TRANSPORT=smtp.
#
# Google Workspace:
#   host      smtp.gmail.com
#   port      587
#   user      the full address of the sending account
#   password  a 16-character App Password, NOT the account password.
#             Google Account > Security > 2-Step Verification > App passwords.
#
# Port 465 also works and is implicit TLS; 587 upgrades with STARTTLS. The code
# derives which from the port, so set the port and leave it alone.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=onboarding@amzai.events
SMTP_PASSWORD=your-16-character-app-password


# ---------------------------------------------------------------------------
# The client-facing domain
# ---------------------------------------------------------------------------

# Where links in emails point. Client surfaces live here and nowhere else.
#
# In development leave this as it is: browsers resolve anything ending in
# .localhost to your own machine, so http://client.localhost:3000 reaches the
# same `npm run dev` as http://localhost:3000 with no setup at all.
#
# In production: https://client.amzai.events
NEXT_PUBLIC_CLIENT_ORIGIN=http://client.localhost:3000
